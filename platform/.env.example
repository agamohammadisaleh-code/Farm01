# ---------- API ----------
PORT=4000
NODE_ENV=development

# گذرواژه امضای JWT — در تولید مقدار تصادفی و محرمانه بگذارید
JWT_SECRET=change-me-in-production

# ---------- پایگاه داده ----------
# اگر PG_DRIVER=postgres باشد، از PostgreSQL واقعی استفاده می‌شود.
# در غیر این صورت PGlite (بدون سرور، مناسب توسعه) فعال است.
PG_DRIVER=postgres
DATABASE_URL=postgres://farm:farm@localhost:5432/farm
PG_POOL_MAX=10

# مسیر داده PGlite در حالت توسعه (memory:// برای حافظه موقت)
# PGLITE_DATA_DIR=.pgdata

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000,https://app.example.com

# ---------- محدودسازی نرخ درخواست (بخش ۱۰) ----------
# سقف کلی هر نشانی در دقیقه برای همه مسیرها
RATE_LIMIT_GLOBAL_MAX=1200
# اگر API پشت پروکسی/بالانسر است، IP واقعی از X-Forwarded-For خوانده شود
# TRUST_PROXY=1
# برای خاموش‌کردن کامل در محیط آزمون
# RATE_LIMIT_DISABLED=1

# ---------- Redis ----------
# با تنظیم این متغیر، شمارنده محدودسازی نرخ بین همه نمونه‌های API مشترک می‌شود.
# اگر Redis بالا نباشد، API با حالت درون‌حافظه ادامه می‌دهد (کش و صف: فاز بعد).
REDIS_URL=redis://localhost:6379

# ---------- سرویس هوش مصنوعی ----------
# اگر خاموش باشد API کار می‌کند و محاسبات محلی را برمی‌گرداند (source: local)
AI_URL=http://localhost:8000
AI_TIMEOUT_MS=2500
# اگر تنظیم شود، درخواست‌ها باید هدر X-AI-Key داشته باشند
# AI_API_KEY=
AI_CORS_ORIGINS=http://localhost:3000
