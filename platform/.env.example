# ---------- API ----------
PORT=4000
NODE_ENV=development

# گذرواژه امضای JWT — در تولید مقدار تصادفی و محرمانه بگذارید
JWT_SECRET=change-me-in-production

# ---------- پایگاه داده ----------
# اگر PG_DRIVER=postgres باشد، از PostgreSQL واقعی استفاده می‌شود.
# در غیر این صورت PGlite (بدون سرور، مناسب توسعه) فعال است.
PG_DRIVER=postgres
DATABASE_URL=postgres://farm:farm@localhost:5432/farm
PG_POOL_MAX=10

# مسیر داده PGlite در حالت توسعه (memory:// برای حافظه موقت)
# PGLITE_DATA_DIR=.pgdata

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000,https://app.example.com

# ---------- Redis (فاز بعد: کش و صف) ----------
REDIS_URL=redis://localhost:6379

# ---------- سرویس هوش مصنوعی (فاز بعد) ----------
AI_SERVICE_URL=http://localhost:8000
